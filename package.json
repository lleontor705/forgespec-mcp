{
  "name": "forgespec-mcp",
  "version": "2.1.0",
  "description": "MCP Server for Spec-Driven Development (SDD) — contract validation, task board, and file reservation for multi-agent AI systems",
  "type": "module",
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./plugin": {
      "import": "./plugins/opencode-forgespec/index.js"
    },
    "./mcp": {
      "import": "./build/index.js"
    },
    "./broker": {
      "import": "./build/identity/broker-cli.js"
    }
  },
  "bin": {
    "forgespec-mcp": "build/index.js",
    "forgespec-identity-broker": "build/identity/broker-cli.js"
  },
  "files": [
    "build",
    "plugins/opencode-forgespec"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "runtime:smoke": "node --import tsx/esm src/runtime/runtime-smoke.ts --mode source --entrypoint src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm test",
    "inspect": "npx @modelcontextprotocol/inspector node build/index.js",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sdd",
    "spec-driven-development",
    "task-board",
    "multi-agent",
    "ai",
    "llm"
  ],
  "author": "lleontor705",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lleontor705/forgespec-mcp.git"
  },
  "engines": {
    "node": ">=22 <23 || >=24 <25 || >=26 <27"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "ip-address": "^10.3.1"
  },
  "volta": {
    "node": "24.18.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "standard-version": "^9.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "bugs": {
    "url": "https://github.com/lleontor705/forgespec-mcp/issues"
  },
  "homepage": "https://github.com/lleontor705/forgespec-mcp#readme"
}
